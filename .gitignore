# ── Swift Package Manager ──────────────────────────────────────────
.build/
.swiftpm/
Package.resolved

# ── Xcode ──────────────────────────────────────────────────────────
# NOTE: do NOT ignore *.xcodeproj/ — that excludes project.pbxproj
# which is the project file itself. We only ignore the per-user
# state inside it.
DerivedData/
build/
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.hmap
*.moved-aside
*.dSYM.zip
*.dSYM/

# ── macOS ──────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Backups (from pbxproj surgery during development) ──────────────
*.bak
*.bak.*
project.pbxproj.bak*

# ── Logs / traces ──────────────────────────────────────────────────
*.log
traces/

# ── Distribution outputs ───────────────────────────────────────────
dist/
*.dmg
*.pkg
*.ipa
*.crash

# ── Local-only config ──────────────────────────────────────────────
.env
.env.local
scratch/
_notes/
TODO.local.md
.claude/settings.local.json

# ── Agent runtime state (conversation-scoped; keep instructions/agents trackable) ──
.agentos/plans/

# ── Editor noise ───────────────────────────────────────────────────
*.swp
*.swo
*~
.vscode/
.idea/

# ── Intentionally COMMITTED (notes for future you) ─────────────────
# Bundled llama.cpp / App/Vendor/llama.cpp is **not** a product path.
# Do not vendor an engine here. App/VibeCoder.xcodeproj/ is committed.

# ── Cloudflare wrangler local state (historical license worker) ──
.wrangler/

# ── Python cache ───────────────────────────────────────────────────
__pycache__/

# ── VibeCoder session state (local only) ─────────────────────────
.vibecoder/

# ── Internal orchestration logs (not for public release) ─────────
HANDOFF/

# ── Build artifacts (regenerated locally; never commit) ─────────
Release/build/
